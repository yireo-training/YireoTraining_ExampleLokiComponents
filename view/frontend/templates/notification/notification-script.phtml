<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @version 0.0.21 */
/** @var Template $block */
/** @var SecureHtmlRenderer $secureRenderer */

$script = <<<'SCRIPT'
    document.addEventListener('alpine:init', () => {
        Alpine.data('ExampleLokiComponentsNotify', () => ({
            ...LokiComponentType,
            notify(event) {
                const buttonElement = event.target;
                const area = buttonElement.getAttribute('data-loki-area');
                const type = buttonElement.getAttribute('data-loki-type');
                const text = buttonElement.getAttribute('data-loki-text');

                if (area === 'js') {
                    Alpine.store('Message').addMessage(type, text);
                    return;
                }

                this.post({
                    area: area,
                    type: type,
                    text: text,
                });
            }
        }));
    });
SCRIPT;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
