{
    "name": "yireo-training/magento2-example-loki-components",
    "version": "0.0.20",
    "description": "Examples of Loki Components",
    "keywords": [
        "loki-example"
    ],
    "type": "magento2-module",
    "require": {
        "loki/magento2-components": "^2.0",
        "loki/magento2-css-utils": "^1.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-customer": "^103.0",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "YireoTraining\\ExampleLokiComponents\\": ""
        }
    },
    "archive": {
        "exclude": [
            "/.github"
        ]
    }
}